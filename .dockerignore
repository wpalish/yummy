# Контекст сборки уезжает на удалённый билдер целиком — держим его маленьким
# и не отправляем туда лишнего.

# Виртуальное окружение (249 МБ) — в образе ставим зависимости заново
.venv/
__pycache__/
*.py[cod]

# Продажи и лиды: телефоны заведений, в образ и на билдер им не место
sales/
data/leads/

# Локальные БД и артефакты
*.db
*.db-wal
*.db-shm
AUDIT_REPORT.md

# Сборка GitHub Pages — в рантайме бэкенда не нужна
docs/

# Тесты и dev-обвязка
tests/
.pytest_cache/
.ruff_cache/
.github/
.claude/

# Секреты и мусор
.env
.env.*
.git/
.gitignore
.DS_Store
